<Window x:Class="CTTools.Features.Terrain.CutFillReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cut and fill"
        Width="440"
        SizeToContent="Height"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#ECEFF1"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CTTools;component/Features/Terrain/TerrainTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Text="Solid volume includes the toposolid thickness. Cut and fill compare the two top faces." TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#455A64"/>
        <TextBlock Text="EXISTING GROUND" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Surfaces}" SelectedItem="{Binding SelectedExisting}"/>
        <TextBlock Text="PROPOSED GROUND" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Surfaces}" SelectedItem="{Binding SelectedProposed}"/>
        <Button Content="Measure" Command="{Binding MeasureCommand}"/>

        <Border Margin="0,12,0,0" Padding="10" Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResult}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Existing solid" Margin="0,2"/>
                <TextBlock Grid.Column="1" Text="{Binding ExistingText}" FontWeight="SemiBold" Margin="12,2,0,2"/>
                <TextBlock Grid.Row="1" Text="Proposed solid" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProposedText}" FontWeight="SemiBold" Margin="12,2,0,2"/>
                <TextBlock Grid.Row="2" Text="Cut" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CutText}" FontWeight="SemiBold" Margin="12,2,0,2"/>
                <TextBlock Grid.Row="3" Text="Fill" Margin="0,2"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FillText}" FontWeight="SemiBold" Margin="12,2,0,2"/>
                <TextBlock Grid.Row="4" Text="Net (cut − fill)" Margin="0,2"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NetText}" FontWeight="SemiBold" Margin="12,2,0,2"/>
                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding GridText}" Margin="0,6,0,0" Foreground="#607D8B" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Button Content="Export CSV" Command="{Binding ExportCommand}"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#37474F"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="#B71C1C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</Window>
