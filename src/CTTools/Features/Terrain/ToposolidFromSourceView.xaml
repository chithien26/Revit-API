<Window x:Class="CTTools.Features.Terrain.ToposolidFromSourceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create toposolid"
        Width="420"
        SizeToContent="Height"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#ECEFF1"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CTTools;component/Features/Terrain/TerrainTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Text="Build a surface from a CAD drawing or a point file." TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#455A64"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="CAD drawing" IsChecked="{Binding IsCadMode, Mode=TwoWay}" GroupName="Source"/>
            <RadioButton Content="Point file" IsChecked="{Binding IsFileMode, Mode=TwoWay}" GroupName="Source"/>
        </StackPanel>

        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFileMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="CAD IMPORT" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding Imports}" SelectedItem="{Binding SelectedImport}"/>
            <TextBlock Text="LAYERS" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding Layers, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFileMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="POINT FILE" Style="{StaticResource Label}"/>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Browse" Width="80" Margin="8,0,0,0" Command="{Binding BrowseCommand}"/>
                <TextBox Text="{Binding FilePath}" IsReadOnly="True" Margin="0"/>
            </DockPanel>
            <TextBlock Text="FILE UNITS" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding UnitName}"/>
        </StackPanel>

        <TextBlock Text="TOPOSOLID TYPE" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"/>
        <TextBlock Text="LEVEL" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"/>
        <Button Content="Create toposolid" Command="{Binding CreateCommand}"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#37474F"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="#B71C1C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</Window>
