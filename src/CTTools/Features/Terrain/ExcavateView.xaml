<Window x:Class="CTTools.Features.Terrain.ExcavateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excavate"
        Width="420"
        SizeToContent="Height"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#ECEFF1"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CTTools;component/Features/Terrain/TerrainTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Text="The pit bottom is flat. The side slope climbs until it meets the existing ground." TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#455A64"/>
        <TextBlock Text="SURFACE" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}"/>
        <TextBlock Text="BOTTOM ELEVATION" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding BottomText, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="SLOPE (VERTICAL : HORIZONTAL)" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding SlopeText, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="Pick bottom and excavate" Command="{Binding ExcavateCommand}"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#37474F"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="#B71C1C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</Window>
