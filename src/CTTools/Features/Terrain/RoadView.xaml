<Window x:Class="CTTools.Features.Terrain.RoadView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Road and sidewalk"
        Width="420"
        SizeToContent="Height"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#ECEFF1"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CTTools;component/Features/Terrain/TerrainTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Text="The outline follows the host surface. A positive offset raises a sidewalk, in millimeters." TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#455A64"/>
        <TextBlock Text="HOST SURFACE" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}"/>
        <TextBlock Text="ROAD TYPE" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"/>
        <TextBlock Text="OFFSET (mm)" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="Pick outline and create" Command="{Binding CreateCommand}"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#37474F"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="#B71C1C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</Window>
