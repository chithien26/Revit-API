<!--
  Copy this file to "secrets.props" (same folder) and fill in the values. secrets.props is git-ignored.

  Use the restricted "cttools_client" role from database/licenses.sql, NEVER the Neon owner role:
  the connection string is embedded in CTTools.dll and can be extracted by anyone who has the DLL.

  Neon shows a URI like  postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
  Npgsql needs the key=value form below. Escape XML characters in the password (& -> &amp;, < -> &lt;).
-->
<Project>
  <PropertyGroup>
    <LicenseConnectionString>Host=ep-xxx-pooler.region.aws.neon.tech;Database=neondb;Username=cttools_client;Password=CHANGE_ME;SSL Mode=Require</LicenseConnectionString>
  </PropertyGroup>
</Project>
